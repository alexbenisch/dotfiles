# OS Files
.DS_Store
Thumbs.db

# Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
*.log

# Temporary files
tmp/
temp/
.tmp/

# Local customizations (not to be shared)
local/
*.local
.env

# Backup files
*.bak
*.backup

# Chezmoi state (managed by chezmoi)
.chezmoi*
# ...but the scripts in here are config, not state. Without this git prunes
# the whole directory and new scripts silently fail to stage.
!.chezmoiscripts/

# System-specific configurations
**/private/
**/*private*

# Agent instructions for this repo -- local only. Anchored with a leading slash
# so it applies to the root file only and leaves docs/CLAUDE.md tracked.
/CLAUDE.md